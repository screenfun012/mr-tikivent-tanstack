# Adresa API-ja za sadržaj stranica i admin.
# Prazno = lokalni režim (sadržaj se čuva u browseru — samo za demo).
# Zaseban server:            VITE_API_BASE=https://api.enginesmr.com/api
# API u ovoj aplikaciji:     VITE_API_BASE=/api
VITE_API_BASE=

# true samo ako se umesto Bearer tokena koriste kolačići
VITE_API_WITH_CREDENTIALS=false
